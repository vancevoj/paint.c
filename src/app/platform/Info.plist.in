<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- paint.c bundle metadata (lanes L2/L4 and I), configured by src/app/CMakeLists.txt.
     High DPI rendering, the icon (Resources/paintc.icns), one instance per
     user (LaunchServices forwards opened documents as drop events), and
     document types for every format paint.c opens; the .pdn and .ora types
     are declared as imported UTIs. -->
<plist version="1.0">
<dict>
  <key>CFBundleName</key>               <string>paint.c</string>
  <key>CFBundleDisplayName</key>        <string>paint.c</string>
  <key>CFBundleIdentifier</key>         <string>org.paintc.paintc</string>
  <key>CFBundleExecutable</key>         <string>paintc</string>
  <key>CFBundlePackageType</key>        <string>APPL</string>
  <key>CFBundleShortVersionString</key> <string>@PROJECT_VERSION@</string>
  <key>CFBundleVersion</key>            <string>@PROJECT_VERSION@</string>
  <key>CFBundleInfoDictionaryVersion</key> <string>6.0</string>
  <key>LSMinimumSystemVersion</key>     <string>13.0</string>
  <key>LSApplicationCategoryType</key>  <string>public.app-category.graphics-design</string>
  <key>NSHighResolutionCapable</key>    <true/>
  <key>NSSupportsAutomaticGraphicsSwitching</key> <true/>
  <key>NSPrincipalClass</key>           <string>NSApplication</string>
  <key>CFBundleIconFile</key>           <string>paintc.icns</string>
  <key>LSMultipleInstancesProhibited</key> <true/>
  <key>NSHumanReadableCopyright</key>   <string>MIT License. See Resources/licenses.</string>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>  <string>Image</string>
      <key>CFBundleTypeRole</key>  <string>Editor</string>
      <key>LSHandlerRank</key>     <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>public.png</string>
        <string>public.jpeg</string>
        <string>com.microsoft.bmp</string>
        <string>com.compuserve.gif</string>
        <string>public.tiff</string>
        <string>org.webmproject.webp</string>
        <string>com.truevision.tga-image</string>
        <string>com.microsoft.dds</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>  <string>Paint.NET image</string>
      <key>CFBundleTypeRole</key>  <string>Editor</string>
      <key>LSHandlerRank</key>     <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array><string>org.paintc.pdn</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>  <string>OpenRaster image</string>
      <key>CFBundleTypeRole</key>  <string>Editor</string>
      <key>LSHandlerRank</key>     <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array><string>org.openraster.ora</string></array>
    </dict>
  </array>
  <key>UTImportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>      <string>org.paintc.pdn</string>
      <key>UTTypeDescription</key>     <string>Paint.NET image</string>
      <key>UTTypeConformsTo</key>      <array><string>public.image</string><string>public.data</string></array>
      <key>UTTypeTagSpecification</key>
      <dict><key>public.filename-extension</key><array><string>pdn</string></array></dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key>      <string>org.openraster.ora</string>
      <key>UTTypeDescription</key>     <string>OpenRaster image</string>
      <key>UTTypeConformsTo</key>      <array><string>public.image</string><string>public.zip-archive</string></array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key><array><string>ora</string></array>
        <key>public.mime-type</key><string>image/openraster</string>
      </dict>
    </dict>
  </array>
</dict>
</plist>
