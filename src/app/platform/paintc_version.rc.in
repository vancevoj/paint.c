/* paintc_version.rc - icon and version information of paintc.exe (lane I),
 * configured from src/app/platform/paintc_version.rc.in by
 * packaging/PcPackaging.cmake; a second resource script next to the
 * manifest one (MinGW) or the only one (MSVC, clang-cl). */
/* Numeric constants instead of <winver.h>, so every resource compiler
 * (windres, rc.exe, llvm-rc) builds it without SDK include paths:
 * VS_VERSION_INFO 1, VOS_NT_WINDOWS32 0x40004, VFT_APP 1, VFT2_UNKNOWN 0. */

/* the first icon in the file is the one Explorer and the taskbar use */
1 ICON "@PC_RC_ICON@"

1 VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "The paint.c authors"
            VALUE "FileDescription",  "paint.c image editor"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "paintc"
            VALUE "LegalCopyright",   "MIT License, see licenses\\LICENSE.txt"
            VALUE "OriginalFilename", "paintc.exe"
            VALUE "ProductName",      "paint.c"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
