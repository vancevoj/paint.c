<?xml version="1.0" encoding="UTF-8"?>
<!-- paint.c MIME types (shared-mime-info). Every other type paint.c opens
     (png, jpeg, bmp, gif, tiff, webp, avif, jxl, x-tga, x-dds, openraster) is already
     defined by freedesktop.org.xml; only the .pdn type is added here. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="image/x-paintnet">
    <comment>Paint.NET image</comment>
    <generic-icon name="image-x-generic"/>
    <magic priority="50">
      <match type="string" value="PDN3" offset="0"/>
    </magic>
    <glob pattern="*.pdn"/>
  </mime-type>
</mime-info>
